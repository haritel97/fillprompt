---
// Keyword filter for a list page. Typing searches every prompt of this kind (not just the page
// on screen) through the shared search index, and swaps the paginated list for the matches.
// Wrap the static list and its pagination in an element with id="filter-static".
import { ui, href, categoryLabels, type Lang } from '../i18n';
import { sources } from '../lib/data';
import { ALIAS } from '../lib/synonyms.mjs';

interface Props {
  lang: Lang;
  /** Which search file to load (/search/<kind>.json): 'i' image, 't' text, 'v' video prompts. */
  kind: 'i' | 't' | 'v';
  /** Only rows whose model has this label. */
  model?: string;
  /** Only image rows in this category (slug). */
  cat?: string;
}
const { lang, kind, model = '', cat = '' } = Astro.props;
const t = ui[lang];
const cfg = {
  kind,
  model,
  cat,
  alias: ALIAS,
  cats: kind === 'i' ? categoryLabels[lang] : {},
  sourceNames: Object.fromEntries(Object.entries(sources).map(([k, x]) => [k, x.name])),
  base: href(lang, { i: '/prompt/', t: '/text-prompt/', v: '/video/' }[kind]),
  none: t.filter.none,
  loadFailed: t.searchPage.loadFailed,
};
---

<div class="quick-filter mt-5 flex max-w-xl items-stretch" data-cfg={JSON.stringify(cfg)}>
  <label class="sr-only" for="qf-input">{t.filter.label}</label>
  <span class="grid w-10 shrink-0 place-items-center border border-r-0 border-ink bg-surface text-muted" aria-hidden="true">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M3 5h18M7 12h10M10 19h4"></path></svg>
  </span>
  <input id="qf-input" type="search" autocomplete="off" placeholder={t.filter.placeholder} class="field min-w-0 flex-1 !py-2.5 text-sm" />
  <span class="qf-count grid min-w-16 place-items-center border border-l-0 border-ink bg-surface px-3 font-mono text-xs text-muted" aria-live="polite"></span>
</div>
<div id="filter-results" class="mt-8 hidden border-t border-ink pt-2"></div>

<script is:inline>
  (() => {
    const box = document.querySelector('.quick-filter');
    if (!box) return;
    const cfg = JSON.parse(box.dataset.cfg);
    const input = box.querySelector('input');
    const count = box.querySelector('.qf-count');
    const results = document.getElementById('filter-results');
    // Looked up when needed: the static list sits further down the page than this script.
    const fixedList = () => document.getElementById('filter-static');
    const MAX = 60;
    let rows; // loaded on first keystroke
    const el = (tag, cls, text) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    };
    const sourceLabel = (key) => (key && cfg.sourceNames[key]) || key || '';
    const sourceOf = (r) => (cfg.kind === 't' ? r[4] : r[6]);
    const load = async () => {
      if (rows) return rows;
      rows = await (await fetch('/search/' + cfg.kind + '.json')).json();
      // Image: model=5, cat0=2, source=6, extra cats from 7. Video/text: model=2.
      if (cfg.model) rows = rows.filter((r) => (cfg.kind === 'i' ? r[5] : r[2]) === cfg.model);
      if (cfg.cat) rows = rows.filter((r) => r[2] === cfg.cat || r.slice(7).includes(cfg.cat));
      return rows;
    };
    const wordHit = (s, w) => s.includes(w) || (cfg.alias[w] || []).some((a) => s.includes(a));
    const parseQuery = (q) => {
      const sources = [];
      const words = [];
      for (const part of q.split(/\s+/).filter(Boolean)) {
        const m = part.match(/^(?:source|in):([a-z0-9_-]+)$/i);
        if (m) sources.push(m[1].toLowerCase());
        else words.push(part);
      }
      return { words, sources };
    };
    const textRow = ([title, slug, model, , source]) => {
      const a = el('a', 'row flex flex-col items-start gap-1 px-1 !py-3');
      a.href = cfg.base + slug;
      a.append(el('span', 'font-semibold', title));
      const meta = [model, sourceLabel(source)].filter(Boolean).join(' · ');
      if (meta) a.append(el('span', 'label', meta));
      return a;
    };
    const videoCard = ([title, slug, model, poster, , clip, source]) => {
      const a = el('a', 'tile group block');
      a.href = cfg.base + slug;
      const frame = el('span', 'tile-img aspect-video overflow-hidden');
      if (poster) {
        const im = el('img', 'h-full w-full object-cover');
        im.src = poster;
        im.alt = title;
        im.loading = 'lazy';
        im.referrerPolicy = 'no-referrer';
        im.onerror = () => (im.style.visibility = 'hidden');
        frame.append(im);
      } else if (clip) {
        // No poster: show a frame of the clip.
        const vid = el('video', 'h-full w-full object-cover');
        vid.src = clip + '#t=0.5';
        vid.muted = true;
        vid.playsInline = true;
        vid.preload = 'metadata';
        vid.tabIndex = -1;
        vid.setAttribute('aria-hidden', 'true');
        frame.append(vid);
      }
      const badge = [model, sourceLabel(source)].filter(Boolean).join(' · ');
      frame.append(el('span', 'absolute bottom-0 left-0 bg-ink px-2 py-1 font-mono text-[10px] uppercase tracking-[0.1em] text-paper', badge));
      a.append(frame, el('span', 'mt-2.5 line-clamp-2 block text-[15px] font-semibold leading-snug', title));
      return a;
    };
    const imageCard = ([title, slug, cat, img, , model, source]) => {
      const a = el('a', 'tile group block');
      a.href = cfg.base + slug;
      const frame = el('span', 'tile-img aspect-square overflow-hidden');
      const im = el('img', 'size-full object-cover');
      im.src = img;
      im.alt = title;
      im.loading = 'lazy';
      im.referrerPolicy = 'no-referrer';
      im.onerror = () => {
        im.removeAttribute('src');
        frame.classList.add('bg-line/60');
      };
      frame.append(im);
      const cap = el('span', 'mt-2.5 block');
      const meta = [(cfg.cats[cat] || cat), model || 'Any image model', sourceLabel(source)].filter(Boolean).join(' / ');
      cap.append(
        el('span', 'line-clamp-2 block text-[15px] font-semibold leading-snug', title),
        el('span', 'label mt-1 block', meta),
      );
      a.append(frame, cap);
      return a;
    };
    const run = async () => {
      const { words, sources } = parseQuery(input.value.trim().toLowerCase());
      if (!words.length && !sources.length) {
        results.classList.add('hidden');
        fixedList()?.classList.remove('hidden');
        count.textContent = '';
        return;
      }
      let all;
      try {
        all = await load();
      } catch {
        results.classList.remove('hidden');
        results.className = 'mt-8 border-t border-ink pt-6';
        fixedList()?.classList.add('hidden');
        count.textContent = '';
        results.replaceChildren(el('p', 'py-6 text-muted', cfg.loadFailed));
        return;
      }
      const hits = all.filter((r) => {
        if (sources.length && !sources.includes(String(sourceOf(r) || '').toLowerCase())) return false;
        if (!words.length) return true;
        const hay = (
          cfg.kind === 'i'
            ? r[0] + ' ' + (cfg.cats[r[2]] || '') + ' ' + (r[4] || '') + ' ' + (r[5] || '') + ' ' + (r[6] || '') + ' ' + sourceLabel(r[6])
            : cfg.kind === 'v'
              ? r[0] + ' ' + (r[2] || '') + ' ' + (r[4] || '') + ' ' + (r[6] || '') + ' ' + sourceLabel(r[6])
              : r[0] + ' ' + (r[2] || '') + ' ' + (r[3] || '') + ' ' + (r[4] || '') + ' ' + (r[5] || '') + ' ' + sourceLabel(r[4])
        ).toLowerCase();
        return words.every((w) => wordHit(hay, w));
      });
      count.textContent = hits.length.toLocaleString('en-US');
      fixedList()?.classList.add('hidden');
      results.classList.remove('hidden');
      results.className = {
        i: 'masonry mt-8 border-t border-ink pt-6',
        v: 'mt-8 grid grid-cols-2 gap-x-5 gap-y-7 border-t border-ink pt-6 md:grid-cols-3 lg:grid-cols-4',
        t: 'mt-8 grid border-t border-ink md:grid-cols-2 md:gap-x-10',
      }[cfg.kind];
      const card = { i: imageCard, v: videoCard, t: textRow }[cfg.kind];
      results.replaceChildren(...(hits.length ? hits.slice(0, MAX).map(card) : [el('p', 'col-span-full py-6 text-muted', cfg.none)]));
    };
    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(run, 140);
    });
  })();
</script>
