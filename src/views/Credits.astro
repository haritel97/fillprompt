---
import Base from '../layouts/Base.astro';
import { sources, skills, communitySkills, sourceByKey, sourceStats, type SourceStat } from '../lib/data';
import { ui, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const c = t.credits;

const usedFor = (s: SourceStat) => {
  if (s.images && !s.videos && !s.texts) return c.usedImages(s.images);
  if (s.videos && !s.images && !s.texts) return c.usedVideos(s.videos);
  if (s.texts && !s.images && !s.videos) return c.usedText(s.texts);
  const parts: string[] = [];
  if (s.images) parts.push(c.usedImages(s.images));
  if (s.videos) parts.push(c.usedVideos(s.videos));
  if (s.texts) parts.push(c.usedText(s.texts));
  return parts.join(' · ');
};

// Prompt collections from live counts, then Anthropic skills (links only).
const rows: [string, string][] = [
  ...sourceStats.map((s) => [s.key, usedFor(s)] as [string, string]),
  ['anthropic', c.usedSkills(skills.length)],
];
---

<Base lang={lang} title={c.title} description={c.metaDesc} crumbs={[[c.title, '/credits']]}>
  <div class="wrap max-w-4xl pt-10">
    <p class="label">{t.about}</p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">{c.title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
      {c.lead}
      {' '}
      <a href={href(lang, '/sources')} class="link font-semibold">{ui[lang].sources.title}</a>.
    </p>

    <div class="mt-8 overflow-x-auto">
      <table class="w-full border-t border-ink text-left text-sm">
        <thead>
          <tr class="border-b border-ink">
            <th class="label py-2.5 pr-4 font-medium">{c.thCollection}</th>
            <th class="label py-2.5 pr-4 font-medium">{c.thBy}</th>
            <th class="label py-2.5 pr-4 font-medium">{c.thLicense}</th>
            <th class="label py-2.5 font-medium">{c.thUsed}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map(([key, used]) => {
              const s = sources[key];
              return (
                <tr class="border-b border-line">
                  <td class="py-3 pr-4">
                    {sourceByKey(key) ? (
                      <>
                        <a href={href(lang, `/source/${key}`)} class="link font-semibold">{s.name}</a>
                        <span class="text-muted"> · </span>
                        <a href={s.url} target="_blank" rel="noopener noreferrer" class="link text-xs text-muted">repo</a>
                      </>
                    ) : (
                      <a href={s.url} target="_blank" rel="noopener noreferrer" class="link font-semibold">{s.name}</a>
                    )}
                  </td>
                  <td class="py-3 pr-4">{s.by}</td>
                  <td class="py-3 pr-4">
                    <a href={s.licenseUrl} target="_blank" rel="noopener noreferrer" class="link">{key === 'anthropic' ? c.perSkill : s.license}</a>
                  </td>
                  <td class="py-3 font-mono text-xs text-muted">{used}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>

    <p class="mt-4 max-w-2xl text-sm text-muted">{c.communityNote(communitySkills.length)}</p>

    <div class="sec mt-14">
      <span class="label">01</span>
      <h2>{c.imagesTitle}</h2>
    </div>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">{c.imagesBody}</p>

    <div id="removal" class="sec mt-12 scroll-mt-24">
      <span class="label">02</span>
      <h2>{c.takedownTitle}</h2>
    </div>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">
      {c.takedownA}
      <a href="mailto:jupiter.mplayplay@gmail.com" class="link font-semibold text-ink">jupiter.mplayplay@gmail.com</a>
      {c.takedownB}
    </p>
  </div>
</Base>
