---
import Base from '../layouts/Base.astro';
import Pagination from '../components/Pagination.astro';
import { excerpt, fmt, pad, type SourceStat } from '../lib/data';
import { SOURCE_PAGE } from '../lib/paths';
import { ui, href, type Lang } from '../i18n';
import { itemList } from '../lib/seo';

interface Props {
  lang: Lang;
  page: any;
  source: SourceStat;
}
const { lang, page, source } = Astro.props;
const t = ui[lang];
const s = t.sources;
const suffix = page.currentPage > 1 ? `, ${t.page(page.currentPage)}` : '';
const title = s.detailMeta(source.name) + suffix;
const description = s.detailLead(source.total, source.name, source.license);
const kindLabel = { image: s.kindImage, video: s.kindVideo, text: s.kindText } as const;
---

<Base
  lang={lang}
  title={title}
  description={description}
  crumbs={[[s.title, '/sources'], [source.name, `/source/${source.key}`]]}
  schema={[itemList(lang, page.data.map((x: { href: string }) => x.href))]}
>
  <div class="wrap pt-10">
    <p class="label">
      <a href={href(lang, '/sources')} class="hover:text-ink">{s.title}</a> / {source.name}
    </p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">{source.name}</h1>
    <p class="mt-3 max-w-2xl text-muted">{description}</p>
    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
      <span>{s.by} {source.by}</span>
      <a href={source.licenseUrl} target="_blank" rel="noopener noreferrer" class="link">{s.license}: {source.license}</a>
      <a href={source.url} target="_blank" rel="noopener noreferrer" class="link">{s.repo}</a>
    </p>
    <p class="mt-2 font-mono text-xs text-muted">{s.counts(source.images, source.videos, source.texts)}</p>

    <div class="mt-8 grid border-t border-ink md:grid-cols-2 md:gap-x-10">
      {
        page.data.map((x: any, i: number) => (
          <a href={href(lang, x.href)} class="row grid grid-cols-[3.25rem_1fr] gap-x-2 px-1 sm:grid-cols-[3.25rem_4.5rem_1fr]">
            <span class="label pt-1">{pad((page.currentPage - 1) * SOURCE_PAGE + i + 1, 4)}</span>
            {x.sample ? (
              <span class="hidden aspect-square overflow-hidden border border-line bg-surface sm:block">
                <img
                  src={x.sample}
                  alt=""
                  loading="lazy"
                  referrerpolicy="no-referrer"
                  class="size-full object-cover"
                  onerror="this.parentElement.style.visibility='hidden'"
                />
              </span>
            ) : (
              <span class="hidden sm:block" aria-hidden="true" />
            )}
            <span>
              <span class="block font-semibold leading-snug">{x.title}</span>
              <span class="mt-1 line-clamp-2 block text-sm text-muted">{excerpt(x.preview, 150)}</span>
              <span class="label mt-1.5 block">
                <span class="text-ink">{kindLabel[x.kind as keyof typeof kindLabel]}</span> / {x.model}
                {x.likes ? ` / ★ ${fmt(x.likes)}` : ''}
              </span>
            </span>
          </a>
        ))
      }
    </div>
    <Pagination lang={lang} page={page} />
    <p class="mt-8">
      <a href={href(lang, '/sources')} class="link text-sm font-semibold">{s.back}</a>
    </p>
  </div>
</Base>
