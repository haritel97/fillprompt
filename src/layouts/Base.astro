---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { ui, href, barePath, type Lang } from '../i18n';
import { SITE, url } from '../lib/seo';
// Cloudflare Web Analytics (free, no cookies): counted on the live site only, not in local builds or previews
const cfBeacon = process.env.VERCEL_ENV === 'production' ? JSON.stringify({ token: 'a2c023ea16904f84917c4522e5ca63d8' }) : null;

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Breadcrumb trail after "Home": [label, root-relative path] pairs. */
  crumbs?: [string, string][];
  /** Extra schema.org objects for this page. */
  schema?: Record<string, unknown>[];
}
const { lang, title, noindex = false, crumbs = [], schema = [] } = Astro.props;
const image = Astro.props.image ?? new URL('/og.png', Astro.site).href;
const t = ui[lang];
const REPO_SLUG = 'haritel97/fillprompt';
const REPO = `https://github.com/${REPO_SLUG}`;
// Long titles drop the site suffix so the page's own words fit in a search result.
const fullTitle = title.includes('fillprompt') || title.length > 48 ? title : `${title} · fillprompt.com`;
// No trailing slash: the host redirects /images/ to /images, and the canonical must name the final URL.
const bare = barePath(Astro.url.pathname).replace(/(.)\/+$/, '$1');
// Paginated list pages (/images/2, /category/x/3) get their page number in the description,
// so no two pages share one.
const pageNo = bare.match(/\/(\d+)$/)?.[1];
const description = (Astro.props.description ?? t.siteDesc) + (pageNo ? ` Page ${pageNo}.` : '');
const abs = (l: Lang) => new URL(href(l, bare), Astro.site);
const nav = [
  ['/images', t.nav.images],
  ['/videos', t.nav.videos],
  ['/text', t.nav.text],
  ['/skills', t.nav.skills],
  ['/credits', t.nav.credits],
  ['/donate', t.nav.donate],
];
const graphs: Record<string, unknown>[] = [...schema];
if (bare === '/') {
  graphs.push(
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'fillprompt.com',
      url: url(lang, '/'),
      inLanguage: lang,
      description,
      publisher: { '@id': `${SITE}/#org` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${url(lang, '/search')}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': `${SITE}/#org`,
      name: 'fillprompt.com',
      url: SITE,
      logo: `${SITE}/apple-touch-icon.png`,
      description: ui.en.siteDesc,
      sameAs: ['https://github.com/haritel97/fillprompt', 'https://ko-fi.com/mwrazzuwan'],
    },
  );
}
if (crumbs.length) {
  graphs.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [['fillprompt.com', '/'], ...crumbs].map(([name, path], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name,
      item: url(lang, path),
    })),
  });
}
const ld = graphs.map((g) => JSON.stringify(g).replace(/</g, '\\u003c'));
const isOn = (p: string) =>
  bare.startsWith(p) ||
  (p === '/images' && /^\/(category|prompt)\//.test(bare)) ||
  (p === '/videos' && bare.startsWith('/video/')) ||
  (p === '/text' && bare.startsWith('/text-prompt'));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Set the theme before the first paint: the saved choice, else the system preference.
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'dark' && theme !== 'light') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={abs(lang)} />
        </>
      )
    }
    <meta property="og:site_name" content="fillprompt.com" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={lang === 'ms' ? 'ms_MY' : 'en_US'} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#f3f0e8" />
    <!-- .ico for browsers, search engines and dashboards that only look at /favicon.ico -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="help" type="text/plain" href="/llms.txt" title="llms.txt" />
    {!noindex && ld.map((json) => <script type="application/ld+json" set:html={json} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col" data-repo={REPO_SLUG}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-mark focus:px-3 focus:py-2 focus:text-sm focus:font-bold">{t.skip}</a>
    <header class="sticky top-0 z-20 border-b border-ink bg-paper">
      <div class="wrap flex h-14 items-center gap-4 sm:gap-6">
        <a href={href(lang, '/')} aria-label={`fillprompt.com, ${t.home}`}><Logo /></a>
        <nav class="hidden items-center gap-5 md:flex" aria-label={t.navLabel}>
          {
            nav.map(([p, label]) => (
              <a
                href={href(lang, p)}
                aria-current={isOn(p) ? 'page' : undefined}
                class:list={['text-sm font-semibold', isOn(p) ? 'bg-mark px-1.5' : 'text-muted transition-colors hover:text-ink']}
              >
                {label}
              </a>
            ))
          }
        </nav>
        <form action={href(lang, '/search')} class="ml-auto hidden items-center sm:flex" role="search">
          <input
            type="search"
            name="q"
            placeholder={t.searchPrompts}
            aria-label={t.searchPrompts}
            class="h-9 w-44 border border-ink border-r-0 bg-surface px-3 text-sm outline-none placeholder:text-muted/70 focus:bg-white lg:w-56"
          />
          <button class="grid h-9 w-9 place-items-center border border-ink bg-ink text-paper transition-colors hover:bg-mark hover:text-ink" aria-label={t.search}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m20 20-4.5-4.5"></path></svg>
          </button>
        </form>
        {/* Hidden until the GitHub API confirms the repository is public; then shows the live star count. */}
        <a
          href={REPO}
          target="_blank"
          rel="noopener"
          class="gh-only hidden h-9 shrink-0 items-stretch border border-ink text-sm font-semibold transition-colors hover:bg-mark sm:flex"
          data-label={t.github.starLabel('{n}')}
          hidden
        >
          <span class="flex items-center gap-1.5 pl-2.5 pr-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"></path></svg>
            <span class="hidden lg:inline">GitHub</span>
          </span>
          <span class="flex items-center gap-1 pr-2.5 font-mono text-xs text-muted">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.94 6.1 6.56.9-4.78 4.6 1.17 6.6L12 17.5l-5.89 3.2 1.17-6.6L2.5 9.5l6.56-.9z"></path></svg>
            <span class="gh-stars">0</span>
          </span>
        </a>
        <button
          type="button"
          id="theme-toggle"
          class="ml-auto grid h-9 w-9 shrink-0 cursor-pointer place-items-center border border-ink transition-colors hover:bg-mark sm:ml-0"
          data-to-dark={t.theme.toDark}
          data-to-light={t.theme.toLight}
          aria-label={t.theme.toDark}
          title={t.theme.toDark}
        >
          {/* Sun shows in the dark theme, moon in the light theme: the icon names where a click takes you. */}
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z"></path></svg>
          <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path></svg>
        </button>
      </div>
      <nav class="wrap flex items-center gap-5 overflow-x-auto border-t border-line py-2 md:hidden" aria-label={t.navLabel}>
        {
          nav.map(([p, label]) => (
            <a href={href(lang, p)} aria-current={isOn(p) ? 'page' : undefined} class:list={['whitespace-nowrap text-sm font-semibold', isOn(p) ? 'bg-mark px-1.5' : 'text-muted']}>
              {label}
            </a>
          ))
        }
        <a href={href(lang, '/search')} class:list={['whitespace-nowrap text-sm font-semibold sm:hidden', isOn('/search') ? 'bg-mark px-1.5' : 'text-muted']}>
          {t.search}
        </a>
      </nav>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-ink text-paper">
      <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <Logo size={30} />
          <p class="mt-4 max-w-sm text-sm leading-relaxed text-paper/70">{t.footer.blurb}</p>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-paper/50">{t.footer.collections}</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-mark" href={href(lang, '/images')}>{t.footer.imagePrompts}</a></li>
            <li><a class="hover:text-mark" href={href(lang, '/videos')}>{t.footer.videoPrompts}</a></li>
            <li><a class="hover:text-mark" href={href(lang, '/text')}>{t.footer.textPrompts}</a></li>
            <li><a class="hover:text-mark" href={href(lang, '/skills')}>{t.footer.agentSkills}</a></li>
            <li><a class="hover:text-mark" href={href(lang, '/mcp')}>{t.footer.mcp}</a></li>
          </ul>
        </div>
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-paper/50">{t.about}</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-mark" href={href(lang, '/credits')}>{t.footer.sources}</a></li>
            <li><a class="hover:text-mark" href={href(lang, '/credits') + '#removal'}>{t.footer.takedown}</a></li>
            <li><a class="hover:text-mark" href={href(lang, '/donate')}><span class="text-hot" aria-hidden="true">♥</span> {t.footer.donate}</a></li>
            <li class="gh-only" hidden><a class="hover:text-mark" href={REPO} target="_blank" rel="noopener">{t.github.source}</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-paper/15">
        <p class="wrap py-4 font-mono text-[11px] uppercase tracking-[0.14em] text-paper/50">{t.footer.strip}</p>
      </div>
    </footer>

    <script is:inline>
      // Theme toggle: flips the theme, remembers the choice, and keeps the button's label in step.
      (() => {
        const btn = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          const label = dark ? btn.dataset.toLight : btn.dataset.toDark;
          btn.setAttribute('aria-label', label);
          btn.title = label;
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#131210' : '#f3f0e8');
        };
        // GitHub stars: ask the public API (cached for an hour per visitor). A private or
        // missing repository answers 404, so the links stay hidden until it is public.
        (async () => {
          const els = document.querySelectorAll('.gh-only');
          if (!els.length) return;
          let n = null;
          try {
            const c = JSON.parse(localStorage.getItem('gh-stars') || 'null');
            if (c && Date.now() - c.t < 3600000) n = c.n;
          } catch {}
          if (n === null) {
            try {
              const r = await fetch('https://api.github.com/repos/' + document.body.dataset.repo);
              if (r.ok) n = (await r.json()).stargazers_count;
              else if (r.status === 404) n = -1;
              try {
                if (n !== null) localStorage.setItem('gh-stars', JSON.stringify({ n, t: Date.now() }));
              } catch {}
            } catch {}
          }
          if (n === null || n < 0) return;
          const text = n >= 1000 ? (n / 1000).toFixed(n >= 10000 ? 0 : 1) + 'k' : String(n);
          els.forEach((el) => {
            el.hidden = false;
            el.querySelectorAll('.gh-stars').forEach((s) => (s.textContent = text));
            if (el.dataset.label) el.setAttribute('aria-label', el.dataset.label.replace('{n}', n.toLocaleString('en-US')));
          });
        })();

        btn.addEventListener('click', () => {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem('theme', root.dataset.theme);
          } catch {}
          sync();
        });
        sync();
      })();
    </script>
    {cfBeacon && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={cfBeacon}></script>}
  </body>
</html>
