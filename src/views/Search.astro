---
import Base from '../layouts/Base.astro';
import { ui, href, categoryLabels, type Lang } from '../i18n';
import { images, videos, texts, sources } from '../lib/data';
import { ALIAS } from '../lib/synonyms.mjs';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const s = t.searchPage;
const promptTotal = images.length + videos.length + texts.length;
const sourceNames = Object.fromEntries(Object.entries(sources).map(([k, x]) => [k, x.name]));
// Everything the client script needs, in the page's language.
const cfg = {
  cats: categoryLabels[lang],
  alias: ALIAS,
  sourceNames,
  imageBase: href(lang, '/prompt/'),
  textBase: href(lang, '/text-prompt/'),
  videoBase: href(lang, '/video/'),
  packsUrl: href(lang, '/packs'),
  packsLabel: t.packs.title,
  sourcesUrl: href(lang, '/sources'),
  sourcesLabel: t.sources.title,
  loadFailed: s.loadFailed,
  start: s.start,
  none: s.none,
  suggest: s.suggest,
  hintSource: s.hintSource,
};
---

<Base lang={lang} title={s.title} description={s.metaDesc(promptTotal)} noindex>
  <div class="wrap pt-10">
    <p class="label">{s.label}</p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">{s.title}</h1>
    <input id="q" type="search" autofocus placeholder={t.searchHint} aria-label={t.searchPrompts} class="field mt-6 max-w-2xl text-lg" />
    <p class="mt-2 text-sm text-muted">{s.hint}</p>
    <p id="status" class="mt-6 font-mono text-sm text-muted">{s.loading}</p>
    <div id="suggest" class="mt-4 flex flex-wrap gap-2"></div>

    <section id="sec-i" class="hidden pt-6">
      <div class="sec">
        <span id="n-i" class="label"></span>
        <h2>{s.images}</h2>
      </div>
      <div id="res-i" class="masonry mt-6"></div>
    </section>
    <section id="sec-v" class="hidden pt-10">
      <div class="sec">
        <span id="n-v" class="label"></span>
        <h2>{s.videos}</h2>
      </div>
      <div id="res-v" class="mt-6 grid grid-cols-2 gap-x-5 gap-y-7 md:grid-cols-3 lg:grid-cols-4"></div>
    </section>
    <section id="sec-t" class="hidden pt-10">
      <div class="sec">
        <span id="n-t" class="label"></span>
        <h2>{s.text}</h2>
      </div>
      <div id="res-t" class="mt-2 grid sm:grid-cols-2 sm:gap-x-10"></div>
    </section>
  </div>
</Base>

<script is:inline define:vars={{ cfg }}>
  (async () => {
    const $ = (id) => document.getElementById(id);
    const input = $('q');
    const MAX = 48;
    // One file per kind, fetched in parallel; each section fills in as its file arrives.
    const idx = { i: [], v: [], t: [] };
    let ready = false;
    let pending = 3;
    const loadingText = $('status').textContent;
    const suggest = $('suggest');
    const el = (tag, cls, text) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    };
    const sourceLabel = (key) => (key && cfg.sourceNames[key]) || key || '';
    const imageCard = ([title, slug, cat, img, , , source]) => {
      const a = el('a', 'tile group block');
      a.href = cfg.imageBase + slug;
      const frame = el('span', 'tile-img aspect-square overflow-hidden');
      const im = el('img', 'size-full object-cover');
      im.src = img;
      im.alt = title;
      im.loading = 'lazy';
      im.referrerPolicy = 'no-referrer';
      im.onerror = () => {
        im.removeAttribute('src');
        frame.classList.add('bg-line/60');
      };
      frame.append(im);
      const cap = el('span', 'mt-2.5 block');
      const meta = [cfg.cats[cat] || cat, sourceLabel(source)].filter(Boolean).join(' · ');
      cap.append(
        el('span', 'line-clamp-2 block text-[15px] font-semibold leading-snug', title),
        el('span', 'label mt-1 block', meta),
      );
      a.append(frame, cap);
      return a;
    };
    const videoCard = ([title, slug, model, poster, , clip, source]) => {
      const a = el('a', 'tile group block');
      a.href = cfg.videoBase + slug;
      const frame = el('span', 'tile-img aspect-video overflow-hidden');
      if (poster) {
        const im = el('img', 'h-full w-full object-cover');
        im.src = poster;
        im.alt = title;
        im.loading = 'lazy';
        im.referrerPolicy = 'no-referrer';
        im.onerror = () => (im.style.visibility = 'hidden');
        frame.append(im);
      } else if (clip) {
        // No poster: show a frame of the clip.
        const vid = el('video', 'h-full w-full object-cover');
        vid.src = clip + '#t=0.5';
        vid.muted = true;
        vid.playsInline = true;
        vid.preload = 'metadata';
        vid.tabIndex = -1;
        vid.setAttribute('aria-hidden', 'true');
        frame.append(vid);
      }
      const cap = el('span', 'mt-2.5 block');
      const meta = [model, sourceLabel(source)].filter(Boolean).join(' · ');
      cap.append(el('span', 'line-clamp-2 block text-[15px] font-semibold leading-snug', title), el('span', 'label mt-1 block', meta));
      a.append(frame, cap);
      return a;
    };
    const textCard = ([title, slug, model, , source]) => {
      const a = el('a', 'row flex flex-col items-start gap-1 px-1 !py-3');
      a.href = cfg.textBase + slug;
      a.append(el('span', 'font-semibold', title));
      const meta = [model, sourceLabel(source)].filter(Boolean).join(' · ');
      if (meta) a.append(el('span', 'label', meta));
      return a;
    };
    const wordHit = (s, w) => s.includes(w) || (cfg.alias[w] || []).some((a) => s.includes(a));
    const parseQuery = (q) => {
      const sources = [];
      const words = [];
      for (const part of q.split(/\s+/).filter(Boolean)) {
        const m = part.match(/^(?:source|in):([a-z0-9_-]+)$/i);
        if (m) sources.push(m[1].toLowerCase());
        else words.push(part);
      }
      return { words, sources };
    };
    const hayI = (r) =>
      (
        r[0] +
        ' ' +
        (cfg.cats[r[2]] || '') +
        ' ' +
        (r[4] || '') +
        ' ' +
        (r[5] || '') +
        ' ' +
        (r[6] || '') +
        ' ' +
        sourceLabel(r[6])
      ).toLowerCase();
    const hayV = (r) =>
      (r[0] + ' ' + r[2] + ' ' + (r[4] || '') + ' ' + (r[6] || '') + ' ' + sourceLabel(r[6])).toLowerCase();
    const hayT = (r) =>
      (r[0] + ' ' + (r[2] || '') + ' ' + (r[3] || '') + ' ' + (r[4] || '') + ' ' + (r[5] || '') + ' ' + sourceLabel(r[4])).toLowerCase();
    const matchRow = (hay, source, words, sources) => {
      if (sources.length && !sources.includes(String(source || '').toLowerCase())) return false;
      return !words.length || words.every((w) => wordHit(hay, w));
    };
    const run = () => {
      if (!ready) return;
      const q = input.value.trim().toLowerCase();
      const { words, sources } = parseQuery(q);
      history.replaceState(null, '', q ? '?q=' + encodeURIComponent(input.value.trim()) : location.pathname);
      if (!words.length && !sources.length) {
        $('status').textContent = cfg.start;
        $('sec-i').classList.add('hidden');
        $('sec-v').classList.add('hidden');
        $('sec-t').classList.add('hidden');
        suggest.replaceChildren();
        return;
      }
      const im = idx.i.filter((r) => matchRow(hayI(r), r[6], words, sources));
      const vd = idx.v.filter((r) => matchRow(hayV(r), r[6], words, sources));
      const tx = idx.t.filter((r) => matchRow(hayT(r), r[4], words, sources));
      const total = im.length + vd.length + tx.length;
      // Until every file is in, an empty result may only mean "not loaded yet".
      $('status').textContent = total ? '' : pending ? loadingText : cfg.none + ' "' + input.value.trim() + '".';
      suggest.replaceChildren();
      if (!total && !pending) {
        const label = document.createElement('span');
        label.className = 'text-xs text-muted uppercase tracking-[0.1em]';
        label.textContent = cfg.suggest;
        suggest.appendChild(label);
        const seen = new Set();
        const chips = [];
        // 1. Shorter query first (most likely to help).
        if (words.length > 1) {
          const shorter = words.slice(0, -1).join(' ');
          const shorterTotal =
            idx.i.filter((r) => matchRow(hayI(r), r[6], words.slice(0, -1), sources)).length +
            idx.v.filter((r) => matchRow(hayV(r), r[6], words.slice(0, -1), sources)).length +
            idx.t.filter((r) => matchRow(hayT(r), r[4], words.slice(0, -1), sources)).length;
          if (shorterTotal > 0) {
            chips.push({ text: shorter, score: 3 });
            seen.add(shorter);
          }
        }
        // 2. Categories/models whose name shares a word with the query.
        for (const r of idx.i) {
          const cat = cfg.cats[r[2]] || r[2];
          if (cat && !seen.has(cat)) {
            const score = words.some((w) => cat.toLowerCase().includes(w)) ? 2 : 0;
            if (score > 0) {
              chips.push({ text: cat, score });
              seen.add(cat);
            }
          }
        }
        for (const r of idx.v) {
          if (r[2] && !seen.has(r[2])) {
            const score = words.some((w) => r[2].toLowerCase().includes(w)) ? 2 : 0;
            if (score > 0) {
              chips.push({ text: r[2], score });
              seen.add(r[2]);
            }
          }
        }
        // 3. Suggest a source: filter when the query matches a collection key or name.
        const sourceKeys = new Set();
        for (const r of idx.i) if (r[6]) sourceKeys.add(r[6]);
        for (const r of idx.v) if (r[6]) sourceKeys.add(r[6]);
        for (const r of idx.t) if (r[4]) sourceKeys.add(r[4]);
        for (const key of sourceKeys) {
          const chip = cfg.hintSource + key;
          if (seen.has(chip)) continue;
          const name = sourceLabel(key).toLowerCase();
          if (words.some((w) => key.includes(w) || w.includes(key) || (name && name.includes(w)))) {
            chips.push({ text: chip, score: 2.5 });
            seen.add(chip);
          }
        }
        chips.sort((a, b) => b.score - a.score);
        // 4. Fill with most popular categories if there is room (max 6 total).
        const catCounts = {};
        for (const r of idx.i) {
          const cat = cfg.cats[r[2]] || r[2];
          if (cat) catCounts[cat] = (catCounts[cat] || 0) + 1;
        }
        const popularCats = Object.entries(catCounts)
          .filter(([cat]) => !seen.has(cat))
          .sort((a, b) => b[1] - a[1])
          .map(([cat]) => cat);
        for (const cat of popularCats) {
          if (chips.length >= 6) break;
          chips.push({ text: cat, score: 1 });
          seen.add(cat);
        }
        for (const chip of chips.slice(0, 6)) {
          const c = document.createElement('button');
          c.type = 'button';
          c.className = 'label border border-ink bg-surface px-2.5 py-1 text-sm hover:bg-mark transition-colors';
          c.textContent = chip.text;
          c.addEventListener('click', () => {
            input.value = chip.text;
            input.dispatchEvent(new Event('input'));
          });
          suggest.appendChild(c);
        }
        const pack = document.createElement('a');
        pack.href = cfg.packsUrl;
        pack.className = 'label border border-ink bg-mark px-2.5 py-1 text-sm hover:bg-paper transition-colors';
        pack.textContent = cfg.packsLabel;
        suggest.appendChild(pack);
        const srcs = document.createElement('a');
        srcs.href = cfg.sourcesUrl;
        srcs.className = 'label border border-ink bg-surface px-2.5 py-1 text-sm hover:bg-mark transition-colors';
        srcs.textContent = cfg.sourcesLabel;
        suggest.appendChild(srcs);
      }
      const show = (key, list, card) => {
        $('sec-' + key).classList.toggle('hidden', !list.length);
        $('n-' + key).textContent = list.length > MAX ? `${MAX} / ${list.length}` : String(list.length);
        $('res-' + key).replaceChildren(...list.slice(0, MAX).map(card));
      };
      show('i', im, imageCard);
      show('v', vd, videoCard);
      show('t', tx, textCard);
    };
    input.value = new URLSearchParams(location.search).get('q') || '';
    let timer;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(run, 150);
    });
    let failed = 0;
    for (const kind of ['i', 'v', 't']) {
      fetch('/search/' + kind + '.json')
        .then((r) => r.json())
        .then((rows) => {
          idx[kind] = rows;
          ready = true;
        })
        .catch(() => failed++)
        .finally(() => {
          pending--;
          if (failed === 3) $('status').textContent = cfg.loadFailed;
          else run();
        });
    }
  })();
</script>
