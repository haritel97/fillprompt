---
import Base from '../layouts/Base.astro';
import { sourceStats, fmt } from '../lib/data';
import { ui, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const s = t.sources;
const filters = [
  ['all', s.filterAll],
  ['image', s.kindImage],
  ['video', s.kindVideo],
  ['text', s.kindText],
] as const;
---

<Base lang={lang} title={s.metaTitle} description={s.metaDesc} crumbs={[[s.title, '/sources']]}>
  <div class="wrap max-w-4xl pt-10">
    <p class="label">{s.label}</p>
    <h1 class="display mt-2 text-4xl sm:text-6xl">{s.title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">{s.lead}</p>

    <div id="source-filters" class="mt-8 flex flex-wrap gap-2" role="group" aria-label={s.filterLabel}>
      {
        filters.map(([key, label], i) => (
          <button
            type="button"
            data-kind={key}
            class:list={['btn-line text-sm', i === 0 && 'bg-mark']}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {label}
          </button>
        ))
      }
    </div>

    <div id="source-list" class="mt-6 divide-y divide-line border-t border-ink">
      {
        sourceStats.map((x) => (
          <div
            class="source-row flex flex-col gap-3 py-5 sm:flex-row sm:items-start sm:justify-between"
            data-image={x.images ? '1' : '0'}
            data-video={x.videos ? '1' : '0'}
            data-text={x.texts ? '1' : '0'}
          >
            <div class="min-w-0">
              <a href={href(lang, `/source/${x.key}`)} class="font-display text-xl font-bold tracking-[-0.02em] hover:text-mark">
                {x.name}
              </a>
              <p class="mt-1 text-sm text-muted">
                {s.by} {x.by} · {x.license}
              </p>
              <p class="mt-1 font-mono text-xs text-muted">{s.counts(x.images, x.videos, x.texts)}</p>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2">
              <a href={href(lang, `/source/${x.key}`)} class="btn-line text-sm">
                {s.browse}
              </a>
              <a href={x.url} target="_blank" rel="noopener noreferrer" class="btn-line text-sm">
                {s.repo}
              </a>
            </div>
          </div>
        ))
      }
    </div>
    <p id="source-summary" class="mt-6 text-sm text-muted">
      {fmt(sourceStats.reduce((a, x) => a + x.total, 0))} prompts across {fmt(sourceStats.length)} collections.
    </p>
  </div>
</Base>

<script is:inline>
  (() => {
    const box = document.getElementById('source-filters');
    const rows = [...document.querySelectorAll('.source-row')];
    const summary = document.getElementById('source-summary');
    if (!box || !rows.length) return;
    const apply = (kind) => {
      for (const btn of box.querySelectorAll('button')) {
        const on = btn.dataset.kind === kind;
        btn.classList.toggle('bg-mark', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      let shown = 0;
      for (const row of rows) {
        const ok = kind === 'all' || row.dataset[kind] === '1';
        row.hidden = !ok;
        if (ok) shown++;
      }
      if (summary) {
        summary.textContent =
          kind === 'all'
            ? summary.dataset.all || summary.textContent
            : shown + ' collection' + (shown === 1 ? '' : 's') + ' with ' + kind + ' prompts.';
      }
    };
    if (summary) summary.dataset.all = summary.textContent;
    box.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-kind]');
      if (btn) apply(btn.dataset.kind);
    });
  })();
</script>
